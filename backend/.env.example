# Copy thành .env rồi chỉnh. Mặc định (không tạo .env) = chạy mock, không cần Ollama.

LLM_PROVIDER=mock
# LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATOR_MODEL=qwen2.5:7b
OLLAMA_CHECKER_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

QDRANT_PATH=./data/qdrant_local
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=edumind_chunks
QDRANT_VECTOR_SIZE=768

MAX_RETRIES=3
FAITHFULNESS_THRESHOLD=0.85
CITATION_MATCH_THRESHOLD=90.0

# DB_PATH: mặc định file SQLite local, không cần tài khoản gì -- đủ cho dev.
# Đặt TURSO_DATABASE_URL + TURSO_AUTH_TOKEN để chuyển sang Turso remote thật
# (tạo free tại turso.tech) -- cần cho bản deploy Render để KHÔNG mất dữ liệu
# mỗi lần service restart/ngủ (xem README mục "DB thật").
DB_PATH=./data/app.db
# TURSO_DATABASE_URL=libsql://<ten-db>-<org>.turso.io
# TURSO_AUTH_TOKEN=...

# CORS_ORIGINS: khớp CHÍNH XÁC 1 hay nhiều origin, cách nhau dấu phẩy.
# CORS_ORIGIN_REGEX: mặc định đã khớp mọi https://edumind-*.vercel.app -- chỉ cần
# đổi nếu tên project Vercel của bạn khác "edumind-...".
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=^https://edumind-.*\.vercel\.app$
